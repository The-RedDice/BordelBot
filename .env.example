# Token du bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# Optionnel : guilde de dev pour enregistrer les commandes instantanément
DISCORD_DEV_GUILD_ID=
# Chemin du fichier SQLite
DATABASE_PATH=./data/bot.sqlite
# debug | info | warn | error
LOG_LEVEL=info
# text (lisible) | json (une ligne JSON par événement)
LOG_FORMAT=text
# Sauvegardes de la base : dossier (par défaut : data/backups à côté de la base)
BACKUP_DIR=
# Nombre de sauvegardes gardées par sorte (quotidiennes, avant migration, manuelles) ; 0 = désactivées
BACKUP_KEEP=7
# Tableau de bord web (facultatif : les trois variables vont ensemble, ou aucune)
# Port local d'écoute ; le tunnel Cloudflare s'y connecte (DASHBOARD_HOST=127.0.0.1 par défaut)
DASHBOARD_PORT=
# Adresse publique, sans / final : https://bot.mondomaine.fr (http://localhost:PORT pour tester en local)
DASHBOARD_URL=
# Developer Portal > OAuth2 > Client Secret ; ajouter aussi la redirection DASHBOARD_URL/auth/callback
DISCORD_CLIENT_SECRET=
