# Token du bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# Optionnel : guilde de dev pour enregistrer les commandes instantanément
DISCORD_DEV_GUILD_ID=
# Chemin du fichier SQLite
DATABASE_PATH=./data/bot.sqlite
# debug | info | warn | error
LOG_LEVEL=info
# text (lisible) | json (une ligne JSON par événement)
LOG_FORMAT=text
